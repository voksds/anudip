{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#anu-diploma","title":"\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e66\uff08ANU Diploma\uff09\u5b98\u65b9\u6837\u5f0f\u89c4\u8303\u4e0e\u5b66\u672f\u9632\u4f2a\u7279\u5f81\u89e3\u6790","text":"<p>\u5bf9\u4e8e\u4f17\u591a\u5728\u6fb3\u5927\u5229\u4e9a\u56fd\u7acb\u5927\u5b66\uff08The Australian National University\uff0c\u7b80\u79f0 ANU\uff09\u5b8c\u6210\u5b66\u4e1a\u7684\u7559\u5b66\u751f\u800c\u8a00\uff0c\u5b98\u65b9\u6388\u4e88\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u4e0d\u4ec5\u662f\u591a\u5e74\u5b66\u672f\u8f9b\u52b3\u7684\u81f3\u9ad8\u89c1\u8bc1\uff0c\u66f4\u662f\u672a\u6765\u6d77\u5185\u5916\u6c42\u804c\u3001\u843d\u6237\u4ee5\u53ca\u5b66\u5386\u8ba4\u8bc1\u7684\u6838\u5fc3\u51ed\u8bc1\u3002\u8fd1\u5e74\u6765\uff0c\u968f\u7740\u8de8\u5883\u4eba\u624d\u6d41\u52a8\u65e5\u8d8b\u9891\u7e41\uff0c\u8de8\u56fd\u4f01\u4e1a\u3001\u5404\u5927\u9ad8\u6821\u4ee5\u53ca\u76f8\u5173\u4eba\u529b\u8d44\u6e90\u90e8\u95e8\u5bf9\u6d77\u5916\u5b66\u5386\u6587\u4ef6\u7684\u6838\u9a8c\u6807\u51c6\u4e5f\u5728\u4e0d\u65ad\u5347\u7ea7\u3002</p> <p></p> <p>\u4e3a\u4e86\u5e2e\u52a9\u6bd5\u4e1a\u751f\u3001HR \u53ca\u5b66\u672f\u80cc\u666f\u8c03\u67e5\u673a\u6784\u6df1\u5165\u4e86\u89e3\u8fd9\u4e00\u5168\u6fb3\u9876\u5c16\u5b66\u5e9c\u7684\u7eb8\u8d28\u4e0e\u6570\u5b57\u5316\u51ed\u8bc1\u89c4\u8303\uff0c\u672c\u6587\u5c06\u7acb\u8db3\u4e8e ANU \u6700\u65b0\u53d1\u5e03\u7684\u5b98\u65b9\u5b66\u4f4d\u8bc1\u4e66\u5b9e\u4f8b\uff0c\u4ece\u89c6\u89c9\u6392\u7248\u8bbe\u8ba1\u3001\u6838\u5fc3\u6587\u672c\u7ed3\u6784\u3001\u7269\u7406\u9632\u4f2a\u5de5\u827a\uff0c\u4ee5\u53ca\u6570\u5b57\u5316\u94fe\u4e0a\u6838\u9a8c\u56db\u5927\u7ef4\u5ea6\u8fdb\u884c\u5168\u65b9\u4f4d\u3001\u6df1\u5ea6\u7684\u4e13\u4e1a\u89e3\u6784\u3002</p>"},{"location":"#_1","title":"\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u6bd5\u4e1a\u8bc1\u5916\u89c2\u8bbe\u8ba1\uff1a\u73b0\u4ee3\u6781\u7b80\u4e0e\u53e4\u5178\u7eb9\u7ae0\u7684\u827a\u672f\u7ed3\u5408","text":"<p>\u4f5c\u4e3a\u201c\u6fb3\u6d32\u516b\u6821\u8054\u76df\u201d\uff08Go8\uff09\u7684\u6838\u5fc3\u6210\u5458\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u5728\u6bd5\u4e1a\u6587\u51ed\u7684\u89c6\u89c9\u8868\u8fbe\u4e0a\u9ad8\u5ea6\u9075\u5faa\u4e86\u56fd\u9645\u9876\u5c16\u9ad8\u6821\u7684\u5b66\u9662\u6d3e\u7f8e\u5b66\u3002</p>"},{"location":"#1","title":"1. \u9ec4\u91d1\u89c6\u89c9\u4e2d\u8f74\u7ebf\u6392\u7248","text":"<p>ANU \u5b98\u65b9\u5b66\u4f4d\u8bc1\u4e66\u91c7\u7528\u6807\u51c6\u7684\u7eb5\u5411\uff08Portrait\uff09A4 \u683c\u5f0f\uff08210\u00d7297mm\uff09\u3002\u5728\u6574\u4f53\u7248\u9762\u5e03\u5c40\u4e0a\uff0c\u8bc1\u4e66\u6452\u5f03\u4e86\u4f20\u7edf\u6b27\u6d32\u9ad8\u6821\u7e41\u590d\u7684\u5df4\u6d1b\u514b\u8fb9\u6846\uff0c\u8f6c\u800c\u5f15\u5165\u4e86\u6781\u5177\u73b0\u4ee3\u611f\u7684\u73b0\u4ee3\u6781\u7b80\u4e3b\u4e49\u4e2d\u8f74\u5bf9\u79f0\u5e03\u5c40\u3002\u8fd9\u79cd\u8bbe\u8ba1\u4f7f\u5f97\u8bc1\u4e66\u6574\u4f53\u89c6\u89c9\u91cd\u5fc3\u5411\u4e0b\u6536\u62e2\uff0c\u65e2\u4fdd\u7559\u4e86\u5b66\u672f\u6587\u4ef6\u7684\u5e84\u4e25\u611f\uff0c\u53c8\u66f4\u4fbf\u4e8e\u73b0\u4ee3\u6570\u5b57\u5316\u626b\u63cf\u4e0e OCR \u5b57\u7b26\u8bc6\u522b\u6280\u672f\u7684\u7cbe\u51c6\u8bfb\u53d6\u3002</p>"},{"location":"#2-vbs","title":"2. \u5b98\u65b9\u6807\u51c6\u89c6\u89c9\u8bc6\u522b\u7cfb\u7edf\uff08VBS\uff09","text":"<p>\u8bc1\u4e66\u9876\u90e8\u5c45\u4e2d\u4f4d\u7f6e\u5448\u73b0\u7684\u662f ANU \u7684\u5b98\u65b9\u5fbd\u6807\uff08Logo\uff09\u3002\u8be5\u5fbd\u6807\u7531\u4e24\u90e8\u5206\u7cbe\u7ec6\u7ec4\u5408\u800c\u6210\uff1a *   \u53e4\u5178\u5b66\u672f\u7eb9\u7ae0\uff08Coat of Arms\uff09\uff1a \u7eb9\u7ae0\u5185\u90e8\u878d\u5165\u4e86\u5357\u5341\u5b57\u661f\u3001\u6fb3\u6d32\u8054\u90a6\u76fe\u5fbd\u4ee5\u53ca\u8c61\u5f81\u7740\u592a\u5e73\u6d0b\u4e0e\u6ce2\u5229\u5c3c\u897f\u4e9a\u6587\u5316\u7684\u4f20\u7edf\u7ebf\u6761\uff0c\u91c7\u7528 Pantone \u4e13\u8272\u5370\u5237\uff0c\u91d1\u8272\u4e0e\u68d5\u8272\u4ea4\u76f8\u8f89\u6620\uff0c\u7ebf\u6761\u5728\u653e\u5927\u955c\u4e0b\u6e05\u6670\u8fb9\u7f18\u65e0\u6bdb\u523a\u3002 *   \u5b98\u65b9\u886c\u7ebf\u5b57\u4f53\uff08Typography\uff09\uff1a \u7eb9\u7ae0\u53f3\u4fa7\u914d\u4ee5\u5b98\u65b9\u89c4\u5b9a\u7684\u6807\u51c6\u5b66\u672f\u5b57\u4f53\u201cAustralian National University\u201d\uff0c\u5b57\u91cd\u7ecf\u8fc7\u4e25\u5bc6\u8c03\u6821\uff0c\u5448\u73b0\u51fa\u6781\u9ad8\u7684\u8fa8\u8bc6\u5ea6\u3002</p>"},{"location":"#anu","title":"ANU\u6587\u51ed\u6838\u5fc3\u6587\u672c\u89c4\u8303\uff1a\u5b66\u58eb\u4e0e\u7855\u58eb\u5b66\u4f4d\u8bc1\u4e66\u533a\u5757\u5316\u62c6\u89e3","text":"<p>\u4e00\u4efd\u771f\u5b9e\u7684 ANU \u6bd5\u4e1a\u8bc1\u4e66\u5728\u6587\u672c\u8868\u8ff0\u3001\u5b57\u4f53\u5c42\u7ea7\u4ee5\u53ca\u7b7e\u7ae0\u5e03\u5c40\u4e0a\uff0c\u90fd\u6709\u7740\u4e25\u683c\u7684\u533a\u5757\u5316\u9632\u4f2a\u89c4\u8303\u3002\u4ee5\u4e0b\u4f9d\u636e\u56fe\u793a\u4e2d\u6700\u65b0\u9881\u53d1\u7684\u91d1\u878d\u5b66\u5b66\u58eb\uff08Bachelor of Finance\uff09\u771f\u5b9e\u8bc1\u4e66\u6837\u672c\u8fdb\u884c\u6df1\u5ea6\u62c6\u89e3\uff1a</p>"},{"location":"#1_1","title":"1. \u5b66\u672f\u5ba3\u544a\u8bed\u533a\u5757","text":"<p>\u8bc1\u4e66\u7684\u6838\u5fc3\u6587\u672c\u533a\u4ee5\u4e00\u53e5\u8bdd\u4f5c\u4e3a\u5b66\u672f\u6548\u529b\u7684\u8d77\u59cb\uff1a</p> <p>\u201cTHIS IS TO CERTIFY THAT FOLLOWING THE COMPLETION OF AN APPROVED PROGRAM OF STUDY...\u201d \u6240\u6709\u82f1\u6587\u5b57\u7b26\u5747\u91c7\u7528\u5168\u5927\u5199\uff08ALL CAPS\uff09\u65e0\u886c\u7ebf\u73b0\u4ee3\u9ed1\u4f53\u3002\u5176\u5b57\u95f4\u8ddd\uff08Kerning\uff09\u548c\u884c\u95f4\u8ddd\uff08Leading\uff09\u7531\u5927\u5b66\u6559\u52a1\u7cfb\u7edf\u81ea\u52a8\u6392\u7248\u751f\u6210\uff0c\u7edd\u5bf9\u7b49\u8ddd\u3002</p>"},{"location":"#2","title":"2. \u6bd5\u4e1a\u751f\u59d3\u540d\u4e0e\u4e3b\u4fee\u5b66\u4f4d\u533a\u5757","text":"<ul> <li>\u59d3\u540d\u5c45\u4e2d\uff1a \u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u59d3\u540d\uff08\u6216\u62fc\u97f3\uff09\u4f4d\u4e8e\u8bc1\u4e66\u7684\u6838\u5fc3\u9ec4\u91d1\u5206\u5272\u70b9\uff0c\u91c7\u7528\u5927\u53f7\u52a0\u7c97\u5b57\u4f53\u3002</li> <li>\u5b66\u4f4d\u540d\u79f0\u653e\u5927\uff1a \u7d27\u968f\u5176\u540e\u7684\u201cHAS BEEN AWARDED THE DEGREE OF\u201d\u4e0b\u65b9\uff0c\u662f\u6574\u5f20\u8bc1\u4e66\u4e2d\u5b57\u53f7\u6700\u5927\u3001\u6700\u77a9\u76ee\u7684\u6838\u5fc3\u6838\u5fc3\u5b57\u5757\uff0c\u4f8b\u5982\u56fe\u4e2d\u7684 \u201cBachelor of Finance\u201d\u3002\u4e3b\u4fee\u5b66\u4f4d\u7684\u5b57\u4f53\u7c97\u7ec6\u3001\u8fb9\u7f18\u5706\u6ed1\u5ea6\u662f\u673a\u5668\u6279\u91cf\u6253\u5370\u4e0e\u5b98\u65b9\u9ad8\u7cbe\u55b7\u58a8\u7684\u5929\u7136\u5206\u6c34\u5cad\u3002</li> </ul>"},{"location":"#3","title":"3. \u6821\u8463\u4f1a\u6388\u6743\u4e0e\u6388\u5370\u65e5\u671f\u533a\u5757","text":"<p>\u8bc1\u4e66\u4e0b\u90e8\u660e\u786e\u6807\u6ce8\u4e86\u6587\u51ed\u7684\u6388\u4e88\u6cd5\u7406\u4f9d\u636e\uff1a</p> <p>\u201cGIVEN UNDER THE SEAL OF THE AUSTRALIAN NATIONAL UNIVERSITY...\u201d \u6b64\u5904\u7684\u6388\u4e88\u65e5\u671f\u4e0d\u4ec5\u9700\u8981\u7cbe\u786e\u5230\u65e5\uff0c\u4e14\u5168\u90e8\u4f7f\u7528\u82f1\u6587\u5927\u5199\u827a\u672f\u5b57\u4e66\u5199\u3002\u8be5\u65e5\u671f\u662f\u672a\u6765\u5bf9\u63a5\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u8ba4\u8bc1\u6570\u636e\u5e93\uff08AQF\uff09\u4ee5\u53ca\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u8fdb\u884c\u5b66\u5386\u6838\u9a8c\u7684\u57fa\u51c6\u65f6\u95f4\u70b9\u3002</p>"},{"location":"#_2","title":"\u8bc1\u4e66\u7269\u7406\u9632\u4f2a\u5de5\u827a\uff1a\u7ea2\u5916\u94a2\u5370\u4e0e\u6570\u5b57\u5316\u5168\u5f69\u9875\u7709\u5b89\u5168\u6280\u672f","text":"<p>\u5728\u7269\u7406\u9632\u4f2a\u5c42\u9762\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u6295\u5165\u4e86\u5927\u91cf\u5de5\u4e1a\u7ea7\u5b89\u5168\u5370\u5237\u6280\u672f\uff0c\u786e\u4fdd\u7eb8\u8d28\u8bc1\u4e66\u5177\u5907\u6781\u9ad8\u4e14\u96be\u4ee5\u88ab\u4eff\u5192\u7684\u7269\u7406\u9632\u4f2a\u5c4f\u969c\u3002</p>"},{"location":"#1-the-university-seal","title":"1. \u4e09\u7ef4\u7acb\u4f53\u7ea2\u5916\u538b\u7eb9\u5706\u7ae0\uff08The University Seal\uff09","text":"<p>\u4f4d\u4e8e\u8bc1\u4e66\u5de6\u4e0b\u89d2\u7684\u5927\u7ea2\u7acb\u4f53\u94a2\u5370\u662f\u6574\u5f20\u8bc1\u4e66\u7684\u6cd5\u7406\u6838\u5fc3\u3002 *   \u9ad8\u7cbe\u5ea6\u6d6e\u96d5\u5de5\u827a\uff1a \u8be5\u5706\u7ae0\u5e76\u975e\u5355\u7eaf\u7684\u5e73\u9762\u6cb9\u58a8\u5370\u5237\uff0c\u800c\u662f\u901a\u8fc7\u673a\u68b0\u91cd\u538b\u5f62\u6210\u7684\u7acb\u4f53\u6d6e\u96d5\u538b\u7eb9\u3002 *   \u7eb9\u7406\u7ec6\u8282\uff1a \u94a2\u5370\u4e2d\u5fc3\u5b8c\u6574\u590d\u523b\u4e86 ANU \u5b98\u65b9\u76fe\u5fbd\u7684\u6ce2\u6d6a\u7eb9\u7406\u4e0e\u8fb9\u7f18\u952f\u9f7f\uff0c\u5176\u51f8\u8d77\u9ad8\u5ea6\u5747\u5300\uff0c\u7528\u624b\u89e6\u6478\u6709\u6781\u4e3a\u660e\u663e\u7684\u51f9\u51f8\u5c42\u6b21\u611f\u3002</p>"},{"location":"#2-interim-officials-signatures","title":"2. \u4e34\u65f6\u4ee3\u7406\u6821\u8463\u53cc\u91cd\u624b\u5199\u7b7e\u7ae0\uff08Interim Officials Signatures\uff09","text":"<p>\u8bc1\u4e66\u53f3\u4e0b\u89d2\u5e38\u6001\u5316\u9a7b\u7559\u4e24\u7ec4\u5173\u952e\u5b66\u672f\u5b98\u5458\u7684\u7b7e\u540d\u533a\u5757\u3002\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u5728\u7279\u5b9a\u8fc7\u6e21\u65f6\u671f\uff08\u5982\u6837\u672c\u6240\u793a\uff09\uff0c\u8bc1\u4e66\u4f1a\u7531\u4e34\u65f6\u6821\u957f\uff08Interim Chancellor\uff09\u4e0e\u4e34\u65f6\u526f\u6821\u957f\uff08Interim Vice-Chancellor\uff09\u5171\u540c\u7b7e\u7f72\u3002 *   \u94a2\u7b14\u58a8\u8ff9\u8fb9\u7f18\u7279\u5f81\uff1a \u771f\u6b63\u7684\u5b98\u65b9\u624b\u5199\u6216\u9ad8\u7cbe\u7535\u5b50\u7b7e\u7ae0\u5728\u653e\u5927\u89c2\u5bdf\u65f6\uff0c\u5176\u8fb9\u7f18\u4f1a\u4f34\u968f\u7eb8\u5f20\u7ea4\u7ef4\u4ea7\u751f\u5fae\u5c0f\u7684\u58a8\u8ff9\u6e17\u900f\uff0c\u7ebf\u6761\u6d41\u5229\u4e14\u5e26\u6709\u5929\u7136\u7684\u538b\u611f\u8f7b\u91cd\u53d8\u5316\uff0c\u800c\u975e\u6b7b\u677f\u7684\u7b49\u7c97\u50cf\u7d20\u7ebf\u6761\u3002</p>"},{"location":"#3-valid-online-viewing-banner","title":"3. \u4e0a\u4e0b\u53cc\u5168\u5f69\u5b89\u5168\u9632\u4f2a\u9875\u7709\uff08Valid Online Viewing Banner\uff09","text":"<p>2020\u5e74\u4ee3\u540e\uff0cANU \u8bc1\u4e66\u8bbe\u8ba1\u5f15\u5165\u4e86\u521b\u65b0\u7684\u201c\u6570\u5b57-\u7269\u7406\u878d\u5408\u5b89\u5168\u8fb9\u6846\u201d\u3002\u5728\u8bc1\u4e66\u7684\u6700\u9876\u7aef\u4e0e\u6700\u5e95\u7aef\uff0c\u5747\u5370\u6709\u4e00\u884c\u6781\u4e3a\u7cbe\u81f4\u7684\u5f69\u8272\u5c0f\u5b57\uff1a</p> <p>\u201cVALID ONLY FOR ONLINE VIEWING AT https://www.myequals.net\u201d \u8be5\u5b57\u6837\u91c7\u7528\u9ad8\u7ebf\u6570\u9632\u4f2a\u5370\u5237\uff0c\u5b57\u8ff9\u6781\u5176\u5fae\u5c0f\u4f46\u6e05\u6670\u53ef\u8fa8\u3002\u5b83\u660e\u786e\u5ba3\u793a\u4e86\u7eb8\u8d28\u8bc1\u4e66\u7684\u6570\u5b57\u6620\u5c04\u6bcd\u4f53\u6240\u5728\u3002</p>"},{"location":"#my-equals","title":"\u6fb3\u6d32\u5927\u5b66\u5b66\u5386\u6838\u9a8c\uff1aMy eQuals \u94fe\u4e0a\u5b89\u5168\u7cfb\u7edf\u4e0e\u5b98\u65b9\u7ba1\u9053\u6bd4\u5bf9","text":"<p>\u73b0\u4ee3\u5b66\u672f\u9632\u4f2a\u65e9\u5df2\u4e0d\u5c40\u9650\u4e8e\u7eb8\u5f20\u672c\u8eab\u3002\u7531\u4e8e\u7269\u7406\u7be1\u6539\u6280\u672f\u7684\u63d0\u5347\uff0c\u6d77\u5916\u9ad8\u6821\u53ca\u4f01\u4e1a\u96c7\u4e3b\u5728\u5ba1\u67e5 ANU \u6bd5\u4e1a\u8bc1\u65f6\uff0c\u5df2\u5168\u9762\u8f6c\u5411\u201c\u6570\u5b57\u5b98\u65b9\u94fe\u4e0a\u6838\u9a8c\u201d\u4e3a\u4e3b\u3001\u7eb8\u8d28\u539f\u4ef6\u4e3a\u8f85\u7684\u590d\u5408\u5ba1\u67e5\u6a21\u5f0f\u3002</p>"},{"location":"#1-my-equals","title":"1. My eQuals \u6570\u5b57\u5316\u5b98\u65b9\u5b89\u5168\u7f51\u7edc","text":"<p>\u5982\u56fe\u4e2d\u9875\u7709\u53ca\u9875\u811a\u5b98\u65b9\u6807\u6ce8\u6240\u793a\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u662f My eQuals \u5b98\u65b9\u6570\u5b57\u5316\u51ed\u8bc1\u5e73\u53f0\u7684\u6df1\u5ea6\u5408\u4f5c\u6821\u3002 *   \u52a0\u5bc6 PDF \u6838\u9a8c\uff1a \u6bd5\u4e1a\u751f\u5728\u6bd5\u4e1a\u65f6\u4f1a\u83b7\u5f97 My eQuals \u7684\u5b98\u65b9\u8d26\u6237\uff0c\u901a\u8fc7\u8be5\u5e73\u53f0\u751f\u6210\u7684\u6570\u5b57\u5316\u52a0\u5bc6\u5b66\u4f4d\u8bc1\u4e66\uff08Digital Testamur\uff09\u5e26\u6709\u5b98\u65b9\u7684\u6570\u5b57\u7b7e\u540d\u4e0e\u4e0d\u53ef\u7be1\u6539\u7684\u52a0\u5bc6\u5bc6\u94a5\u3002 *   \u96c7\u4e3b\u4e00\u952e\u9a8c\u8bc1\uff1a \u7b2c\u4e09\u65b9\u673a\u6784\uff08\u5982HR\u3001\u80cc\u8c03\u516c\u53f8\uff09\u53ea\u9700\u70b9\u51fb\u6bd5\u4e1a\u751f\u901a\u8fc7\u5b98\u65b9\u53d1\u9001\u7684 My eQuals \u5b89\u5168\u5206\u4eab\u94fe\u63a5\uff0c\u5373\u53ef\u5728\u6d4f\u89c8\u5668\u76f4\u63a5\u67e5\u770b\u7531 ANU \u6570\u636e\u5e93\u5b9e\u65f6\u751f\u6210\u7684\u7535\u5b50\u8bc1\u4e66\uff0c\u4efb\u4f55\u5bf9\u5176\u8fdb\u884c\u7684\u622a\u56fe\u7be1\u6539\u90fd\u5c06\u5728\u94fe\u4e0a\u6838\u9a8c\u4e2d\u5931\u6548\u3002</p>"},{"location":"#2-anu-graduate-search","title":"2. ANU Graduate Search \u516c\u5f00\u6821\u53cb\u6570\u636e\u5e93","text":"<p>\u9664\u4e86\u79c1\u6709\u94fe\u63a5\u5206\u4eab\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u8fd8\u9762\u5411\u5168\u7403\u5f00\u653e\u4e86\u516c\u5f00\u6838\u9a8c\u6e20\u9053\uff1a *   \u9a8c\u8bc1\u673a\u6784\u53ef\u76f4\u63a5\u8bbf\u95ee ANU \u5b98\u65b9\u7f51\u7ad9\u7684 Graduate Search\uff08\u6bd5\u4e1a\u751f\u68c0\u7d22\u7cfb\u7edf\uff09\u3002 *   \u53ea\u9700\u8f93\u5165\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u59d3\u540d\uff0c\u7cfb\u7edf\u4fbf\u4f1a\u81ea\u52a8\u516c\u5f00\u68c0\u7d22\u5e76\u8fd4\u56de\u5176\u6b63\u5f0f\u88ab\u6388\u4e88\u5b66\u4f4d\u7684\u540d\u79f0\u3001\u8363\u8a89\u7b49\u7ea7\uff08Honours\uff09\u3001\u4ee5\u53ca\u786e\u5207\u7684\u6388\u4e88\u65e5\u671f\uff08Conferral Date\uff09\u3002\u82e5\u7eb8\u8d28\u8bc1\u4e66\u4e0a\u7684\u4fe1\u606f\u4e0e\u8be5\u6570\u636e\u5e93\u516c\u5f00\u6570\u636e\u4e0d\u4e00\u81f4\uff0c\u5219\u8be5\u5b66\u5386\u6587\u4ef6\u5373\u523b\u5931\u53bb\u771f\u5b9e\u6027\u6548\u529b\u3002</p>"},{"location":"#_3","title":"\u603b\u7ed3\uff1a\u5982\u4f55\u591a\u7ef4\u5ea6\u786e\u4fdd\u6d77\u5916\u5b66\u5386\u6587\u51ed\u7684\u771f\u5b9e\u4e0e\u5408\u89c4\uff1f","text":"<p>\u7efc\u4e0a\u6240\u8ff0\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\uff08ANU\uff09\u6bd5\u4e1a\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e00\u9879\u7cbe\u7f8e\u7684\u524d\u7aef\u89c6\u89c9\u89c6\u89c9\u8bbe\u8ba1\u4f5c\u54c1\uff0c\u66f4\u662f\u878d\u5408\u4e86\u73b0\u4ee3\u5de5\u4e1a\u5370\u5237\u5de5\u827a\u4e0e\u5206\u5e03\u5f0f\u6570\u5b57\u52a0\u5bc6\u6280\u672f\u7684\u5b89\u5168\u5b66\u4fe1\u51ed\u8bc1\u3002</p> <p>\u65e0\u8bba\u662f\u6bd5\u4e1a\u751f\u5728\u9762\u5bf9\u8de8\u56fd\u5165\u804c\u5ba1\u67e5\u3001\u4e00\u3001\u4e8c\u7ebf\u57ce\u5e02\u4eba\u624d\u5f15\u8fdb\u843d\u6237\u65f6\uff0c\u8fd8\u662f\u4f01\u4e1aHR\u5728\u9762\u5bf9\u6d77\u5916\u9ad8\u7cbe\u5c16\u4eba\u624d\u7684\u8d44\u8d28\u80cc\u666f\u8c03\u67e5\u65f6\uff0c\u901a\u8fc7\u201c\u6bd4\u5bf9\u7eb8\u8d28\u89c6\u89c9\u89c4\u8303\uff08\u5982Logo\u4e13\u8272\u3001\u7acb\u4f53\u94a2\u5370\uff09\u201d \u2795 \u201c\u8c03\u7528\u5b98\u65b9\u6570\u5b57\u5316\u6e20\u9053\uff08My eQuals / ANU Graduate Search\uff09\u201d \u7684\u53cc\u8f68\u5236\u5ba1\u6838\u65b9\u5f0f\uff0c\u5373\u53ef\u767e\u5206\u4e4b\u767e\u786e\u4fdd\u5b66\u5386\u6587\u4ef6\u7684\u5408\u89c4\u6027\u4e0e\u771f\u5b9e\u6027\uff0c\u8ba9\u771f\u6b63\u7684\u540d\u6821\u5b66\u672f\u6210\u679c\u83b7\u5f97\u5176\u5e94\u6709\u7684\u56fd\u9645\u5c0a\u91cd\u4e0e\u793e\u4f1a\u4ef7\u503c\u3002 2. \u9632\u8303\u4f2a\u9020\u6837\u672c\uff1a\u5e02\u9762\u4e0a\u6240\u8c13\u7684\u201c\u51fa\u5165\u5883\u8bb0\u5f55\u751f\u6210\u5668\u201d\u6216\u53ef\u968f\u610f\u4fee\u6539\u7684Excel/Word\u6a21\u677f\u5747\u5c5e\u4e8e\u975e\u6cd5\u4f2a\u9020\u6587\u4e66\u3002\u56fd\u5185\u5916\u5ba1\u6838\u673a\u6784\u5bf9\u9999\u6e2f\u5165\u5883\u5904\u81ea\u5e26\u9632\u4f2a\u6807\u8bc6\u7684\u8bc1\u660e\u6709\u7740\u6781\u9ad8\u7684\u8fa8\u522b\u80fd\u529b\uff0c\u8bf7\u52a1\u5fc5\u901a\u8fc7\u5b98\u65b9\u6b63\u89c4\u6e20\u9053\u7533\u9886\uff0c\u5207\u52ff\u4ee5\u8eab\u8bd5\u6cd5\u3002</p>"}]}